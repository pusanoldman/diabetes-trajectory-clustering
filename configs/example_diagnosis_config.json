{
  "data_path": "data/data.csv",
  "out_dir": "outputs/diagnosis",
  "id_col": "RID",
  "status_col": "status_당뇨병",
  "dx_time_col": "tt_당뇨병",
  "incident_dm_value": 1,
  "analysis_mode": "diagnosis",
  "cluster_base_vars": ["HBA1C", "BMI", "HOMA_IR", "HOMA_B"],
  "static_vars": [],
  "include_age_at_dx": true,
  "age_base_var": "연령",
  "k_primary": 4,
  "k_range": [2, 3, 4, 5, 6, 7],
  "cluster_method": "kmeans",
  "window_years": 10,
  "min_visits": 1,
  "include_diagnosis_visit": true,
  "max_post_dx_years": 0.25,
  "feature_mode": "summary",
  "trajectory_features": ["last", "delta", "slope"],
  "grid_times": [-10, -8, -6, -4, -2, 0],
  "allow_grid_extrapolation": false,
  "transforms": {
    "HOMA_IR": "log1p",
    "TG": "log1p",
    "공복인슐린": "log1p"
  },
  "nonpositive_as_na": ["HOMA_IR", "HOMA_B"],
  "winsorize": true,
  "winsorize_q": [0.01, 0.99],
  "max_row_missing": 0.5,
  "max_col_missing": 0.8,
  "imputer_method": "median",
  "time_bin_width": 2.0,
  "random_state": 2026,
  "save_outputs": true
}
